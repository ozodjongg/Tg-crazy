PORT=8080
DATABASE_URL=postgres://tgcrazy:tgcrazy@127.0.0.1:5432/tgcrazy?sslmode=disable
# Kamida 32 belgi: `openssl rand -base64 48`
JWT_SECRET=
# Frontend manzillari, vergul bilan
CORS_ORIGINS=http://localhost:3000

# @BotFather'dan olingan token. Bo'sh bo'lsa ulanish (auth) o'chiq.
BOT_TOKEN=

# ---- AI ----
# Qaysi provayder ishlatilsin: auto | anthropic | gemini
#   auto      — qaysi kalit bor bo'lsa o'sha; ikkalasi ham bo'lsa Anthropic asosiy, Gemini zaxira
#   anthropic — Anthropic asosiy (ANTHROPIC_API_KEY majburiy), Gemini kaliti bo'lsa zaxira
#   gemini    — Gemini asosiy (GEMINI_API_KEY majburiy), Anthropic kaliti bo'lsa zaxira
# Ikkala kalit ham bo'sh bo'lsa AI o'chiq.
AI_PROVIDER=auto

# Ikkala kalit bo'lsa: asosiy provayder ishlamay qolsa (tarmoq, limit, server xatosi,
# noto'g'ri kalit) ikkinchisiga o'tish. false — faqat asosiy provayder ishlatiladi.
AI_FALLBACK=true

# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
